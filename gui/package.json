{
  "name": "@chess-lab/gui",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-chessboard": "5.12.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "vite": "7.3.7",
    "vitest": "4.0.18",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "27.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0"
  }
}
