# Loaded only in disposable builds through CMAKE_PROJECT_INCLUDE.
# Retain strict PGO on trained production targets; no PGO on test-only TUs.
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  function(celab_pgo_scope dir)
    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(t IN LISTS targets)
      get_target_property(kind "${t}" TYPE)
      if(kind MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
        if(NOT t MATCHES "^(chess_core|chess_evaluation|material_provider|material_evaluator|material_pst_evaluator|chess_search|chess_lab_uci)$")
          target_compile_options("${t}" PRIVATE "${CELAB_PGO_SCOPE_DISABLE}")
        endif()
      endif()
    endforeach()
    get_property(children DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
      celab_pgo_scope("${child}")
    endforeach()
  endfunction()
  cmake_language(DEFER CALL celab_pgo_scope "${CMAKE_SOURCE_DIR}")
endif()
