{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "native-release",
      "inherits": "native-debug",
      "displayName": "Native Release",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm-debug",
      "inherits": "native-debug",
      "displayName": "Emscripten Debug (activate emsdk first)",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "jobs": 2 },
    { "name": "native-release", "configurePreset": "native-release", "jobs": 2 },
    { "name": "wasm-debug", "configurePreset": "wasm-debug", "jobs": 2 }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "native-release", "configurePreset": "native-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "wasm-debug", "configurePreset": "wasm-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
